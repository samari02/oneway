{
  "manifest_version": 3,
  "name": "Clarity - Focus & Flow",
  "version": "0.1.0",
  "description": "Intelligent distraction blocker for focused work",
  
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  
  "optional_permissions": [
    "history"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  
  "content_scripts": [],
  
  "action": {
    "default_popup": "popup.html"
  },
  
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "default_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
