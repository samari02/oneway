{
  "manifest_version": 3,
  "name": "Clarity - Focus & Flow",
  "version": "0.1.0",
  "description": "Intelligent distraction blocker for focused work",

  "incognito": "split",
  
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "webNavigation",
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "notifications"
  ],
  
  "optional_permissions": [
    "history"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_popup": "popup.html"
  },
  
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "default_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "web_accessible_resources": [
    {
      "resources": [
        "block-screen.html",
        "block-screen.css",
        "block-screen.js",
        "icons/*",
        "companion-avatars/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
