{
  "version": 3,
  "updated": "2026-11-15",
  "description": "Curated search-engine atlas + bounded ccTLD expansion. Policy: hard-block every atlas host except allowlist (google.com SERP + Gemini + ChatGPT). Methodology: hand-curated brand inventory (no open-web crawl); engines with expandCctlds get brand.<commonCctlds> merged by expand-search-engine-atlas.mjs; optional --ct-stub documents future NRD/CT watch only.",
  "methodology": {
    "curated": true,
    "crawler": false,
    "expandScript": "apps/extension/scripts/lib/expand-search-engine-atlas.mjs",
    "expandRule": "For engines with expandCctlds + hostPrefix, add brand.<tld> for each entry in commonCctlds (deduped). Does not invent new brands.",
    "ctWatch": "Optional --ct-stub only; Certificate Transparency / NRD watch not implemented.",
    "allowlistPolicy": "Only google.com / www.google.com, gemini.google.com / bard.google.com, chatgpt.com / chat.openai.com. All other atlas hosts → DNR hard-block (ids 22000–22999).",
    "categories": [
      "global",
      "yandex-cctld",
      "ru-ua-cis-ee",
      "asia",
      "latam-eu-me",
      "ai-search",
      "meta-privacy"
    ]
  },
  "policy": {
    "defaultMode": "hard-block",
    "notes": [
      "ALLOWLIST ONLY: google.com / www.google.com (SERP + SafeSearch + Layer 2), gemini.google.com / bard.google.com (Gemini), chatgpt.com / chat.openai.com (ChatGPT).",
      "All other atlas engines (yandex.*, bing, duckduckgo, perplexity, you.com, baidu, regional, other AI search, google ccTLDs like google.fr / google.co.jp, …) are DNR hard-blocked to the Clarity block screen — not SafeSearch/filter-only.",
      "google.* country TLDs are intentionally blocked (user: sauf google.com). Documented tradeoff: users must use google.com.",
      "Do not list CDN/static hosts for allowlisted apps (oaiusercontent, gstatic for Gemini) — blocking those would break ChatGPT/Gemini.",
      "Optional future: NRD/CT watch for new yandex.* / brand.* — stub only (see expand script --ct-stub)."
    ],
    "allowlistHosts": [
      "google.com",
      "www.google.com",
      "gemini.google.com",
      "bard.google.com",
      "chatgpt.com",
      "chat.openai.com"
    ]
  },
