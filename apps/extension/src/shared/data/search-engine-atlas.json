{
  "version": 1,
  "updated": "2026-11-15",
  "description": "Curated search-engine atlas for Clarity Layer 2 + SafeSearch DNR. Cheap inventory (no open crawler). Google keeps existing SafeSearch/Layer2 behavior; expand coverage for non-google.ccTLD engines + AI search portals.",
  "policy": {
    "defaultMode": "safesearch+filter",
    "notes": [
      "Traditional SERP engines: DNR SafeSearch rewrite (when param known) + Layer 2 query intelligence (same path as yandex.com).",
      "AI search portals: Layer 2 filter-only (no reliable SafeSearch param) — explicit queries blocked like other engines; NOT hard-blocked as adult sites.",
      "Hard adult-block path stays on adult-blocklist/DNR requestDomains — do not put search engines there.",
      "Optional future: NRD/CT watch for new yandex.* / brand.* — stub only (see expand script --ct-stub)."
    ]
  },
  "commonCctlds": [
    "com", "ru", "by", "kz", "ua", "uz", "az", "am", "ge", "kg", "tj", "tm", "md",
    "ee", "lt", "lv", "pl", "fr", "de", "it", "es", "nl", "be", "ch", "at", "pt",
    "co.uk", "com.tr", "com.ua", "co.jp", "com.br", "com.mx", "co.in", "com.au",
    "co.kr", "jp", "cn", "tw", "hk", "sg", "in", "eu", "net", "org"
  ],
  "engines": [
    {
      "id": "google",
      "brand": "Google",
      "mode": "google-special",
      "queryParams": ["q"],
      "pathIncludes": [],
      "hosts": [
        "google.com", "google.fr", "google.de", "google.co.uk", "google.es",
        "google.it", "google.ca", "google.com.au", "google.ch", "google.be",
        "google.nl", "google.pt", "google.com.br", "google.com.mx", "google.co.in",
        "google.co.jp", "google.co.kr", "google.ru", "google.pl", "google.at"
      ],
      "hostPrefix": "google.",
      "safeSearch": {
        "param": "safe",
        "value": "active",
        "urlFilters": ["/search*"]
      },
      "notes": "Preserve existing Layer2 + SafeSearch; hostPrefix covers other google.* TLDs at runtime."
    },
    {
      "id": "bing",
      "brand": "Bing",
      "mode": "safesearch+filter",
      "queryParams": ["q"],
      "pathIncludes": [],
      "hosts": ["bing.com", "www.bing.com", "cn.bing.com"],
      "safeSearch": {
        "param": "adlt",
        "value": "strict",
        "urlFilters": ["/search*", "/images/search*", "/videos/search*"]
