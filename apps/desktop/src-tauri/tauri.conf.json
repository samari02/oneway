{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clarity",
  "version": "0.1.0",
  "identifier": "com.clarity.app",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clarity",
        "width": 1600,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 800,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data: mediastream: https://api.openai.com; script-src 'self' 'unsafe-eval'; connect-src 'self' https://api.openai.com https://*.supabase.co wss://*.supabase.co http://localhost:* ws://localhost:*; media-src 'self' blob: mediastream:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
