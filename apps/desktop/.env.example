# Copy this file to `.env.local` in this folder (`apps/desktop/.env.local`).
# Vite only loads env files next to the app; there is no `.env` at the oneway repo root for the desktop app.
#
# Get values from Supabase → Project Settings → API (Project URL + anon or publishable key).
#
# If you do NOT create `.env.local`, the app uses defaults from:
#   packages/shared/src/constants.ts  (SUPABASE_URL / SUPABASE_ANON_KEY)
# Your Supabase dashboard must be the SAME project ref as that URL, or rows will appear "empty"
# when you look at a different project.
#
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
