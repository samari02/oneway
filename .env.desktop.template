# This file is a pointer for the monorepo root.
# Vite does NOT read env files from the repository root.
#
# Real configuration for the desktop app lives here:
#   apps/desktop/.env.local
#
# Setup:
#   cd apps/desktop
#   cp .env.example .env.local
#   # Edit .env.local with Supabase → Project Settings → API
#
# Variables to set in apps/desktop/.env.local:
#   VITE_SUPABASE_URL=https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon or publishable key>
